      "faq": {
        "q1": {
          "question": "Does the software support multi-club / multi-site networks?",
          "answer": "Yes. GymWatch provides a consolidated view and per-club filters for members, memberships, access control and reporting."
        },
        "q2": {
          "question": "How does access control work?",
          "answer": "QR codes or badges, real-time validation and instant alerts. Permissions are driven by location, membership type and time slots."
        },
        "q3": {
          "question": "Can reminders and payments be automated?",
          "answer": "Yes, email/SMS reminders for due dates and failed payments are built-in. Invoices are generated automatically and can be exported."
        },
        "q4": {
          "question": "Is there help for rollout and onboarding?",
          "answer": "Our team helps you migrate data, configure access and train staff in just a few days."
        },
        "q5": {
          "question": "Is the service secure?",
          "answer": "Encryption, backups, granular roles and audit logs of sensitive actions for reliable gym management software."
        }
