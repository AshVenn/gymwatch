generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ============================
 * ENUMS
 * ============================
 */

enum UserRole {
  SUPER_ADMIN
  SUPER_MANAGER
  GYM_OWNER
  GYM_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum GymPlanTier {
  BASIC
  PRO
  ENTERPRISE
}

enum GymBillingInterval {
  MONTHLY
  ANNUAL
}

enum GymSubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRES_TODAY
  EXPIRED
}

enum DemoRequestStatus {
  PENDING
  RESOLVED
  REFUSED
}

enum AccessEventStatus {
  GRANTED
  CHECKED_OUT
  SESSION_OVERSTAY
  ALREADY_CHECKED_IN
  DENIED_DAILY_LIMIT
  DENIED_EXPIRED
  DENIED_INACTIVE
  DENIED_FORBIDDEN
}

enum AccessEventSource {
  QR_SCAN
  SIMULATOR
  MANUAL
}

enum AccessRuleType {
  OVERSTAY
  ENTRY_BURST
  CAPACITY_RISK
  STALE_OPEN_VISIT
}

enum AccessRuleSeverity {
  INFO
  WARNING
  CRITICAL
}

enum PlanFeatureFlag {
  accessControl
  presenceTracking
  courses
  qrTools
  qrDownloads
  excelReports
}

enum GymFreezeStatus {
  ACTIVE
  LIFTED
}

enum ClassBookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

/**
 * ============================
 * MODELS
 * ============================
 */

model SystemSettings {
  id                    Int      @id @default(1)
  supportEmail          String   @default("support@gymwatch.ma")
  supportPhone          String   @default("+212600000000")
  brandColor            String   @default("#5b4bff")
  expiryReminder        Boolean  @default(true)
  weeklyDigest          Boolean  @default(true)
  incidentAlerts        Boolean  @default(true)
  payoutReport          Boolean  @default(false)
  gymSettingsIntervalMs Int      @default(60000)
  userSettingsIntervalMs Int     @default(30000)
  accessLogRetentionDays Int     @default(90)
  lastPurgeAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanSettings {
  id                    Int      @id @default(1)
  basicMonthlyPrice     Float    @default(200)
  proMonthlyPrice       Float    @default(350)
  enterpriseMonthlyPrice Float   @default(520)
  annualDiscountPercent Int      @default(15)
  basicPlanLimitPerVariant Int   @default(3)
  basicPlanLimitPerNetwork Int   @default(3)
  proPlanLimitPerVariant Int     @default(6)
  proPlanLimitPerNetwork Int     @default(10)
  enterprisePlanLimitPerVariant Int @default(-1)
  enterprisePlanLimitPerNetwork Int @default(-1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  password             String
  role                 UserRole
  status               UserStatus      @default(ACTIVE)
  firstName            String?
  lastName             String?
  gymId                String?
  gym                  Gym?            @relation(fields: [gymId], references: [id], onDelete: SetNull)
  gymVariantId         String?
  gymVariant           GymVariant?     @relation(fields: [gymVariantId], references: [id], onDelete: SetNull)
  ownedGym             Gym?            @relation("GymOwner")
  resolvedDemoRequests DemoRequest[]   @relation("DemoRequestResolvedBy")
  auditLogs            AuditLog[]
  preferences          UserPreference?
  sessionVersion       Int             @default(0)
  lastLoginAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  UserRole
  actorEmail String
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Gym {
  id                          String                @id @default(cuid())
  name                        String
  email                       String                @unique
  phone                       String?
  address                     String?
  city                        String?
  country                     String?
  logoUrl                     String?
  subscriptionPlan            GymPlanTier           @default(BASIC)
  billingInterval             GymBillingInterval    @default(MONTHLY)
  subscriptionPrice           Float                 @default(0)
  subscriptionStatus          GymSubscriptionStatus @default(ACTIVE)
  subscriptionStartedAt       DateTime              @default(now())
  subscriptionExpiresAt       DateTime?
  isDemo                      Boolean               @default(false)
  demoEndsAt                  DateTime?
  subscriptionGracePeriodDays Int                   @default(0)
  maxSessionMinutes           Int                   @default(180)
  maxAdminAccounts            Int                   @default(3)
  maxMembers                  Int                   @default(-1)
  maxVariants                 Int                   @default(-1)
  capacity                    Int                   @default(0)
  lastSettingsUpdateAt        DateTime?
  todayVisitorCount           Int                   @default(0)
  todayVisitorDate            DateTime?             @default(now())
  ownerId                     String?               @unique
  owner                       User?                 @relation("GymOwner", fields: [ownerId], references: [id])
  planLimitPerVariant         Int?
  planLimitPerNetwork         Int?
  analyticsSnapshot           Json?
  tenantPlans                 TenantPlan[]
  ruleEvents                  AccessRuleEvent[]
  users                       User[]
  membershipPlans             MembershipPlan[]
  members                     Member[]
  subscriptions               Subscription[]
  payments                    Payment[]
  variants                    GymVariant[]
  visits                      Visit[]
  featureOverrides            FeatureOverride[]
  classSessions               ClassSession[]
  createdDemoRequests         DemoRequest[]         @relation("DemoRequestCreatedGym")
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
}

model GymVariant {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  isDefault   Boolean  @default(false)
  maxSessionMinutes Int?
  capacity    Int?     @default(0)
  members     Member[]
  subscriptions Subscription[]
  membershipPlans MembershipPlan[]
  admins      User[]
  visits      Visit[]
  ruleEvents  AccessRuleEvent[]
  classSessions ClassSession[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([gymId, slug])
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         String   @default("system")
  locale        String   @default("fr")
  notifications Boolean  @default(true)
  weeklySummary Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastChangedAt DateTime @default(now())
}

model MembershipPlan {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name         String
  durationDays Int
  price        Float
  visitsPerDay Int     @default(1)
  maxSessionMinutes Int?
  isActive     Boolean @default(true)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymVariantId])
}

model Member {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)

  firstName     String
  lastName      String
  email         String?
  phone         String?
  qrToken       String   @unique @default(dbgenerated("encode(gen_random_bytes(16), 'hex')"))
  qrGeneratedAt DateTime @default(now())
  lastVisitedAt DateTime?

  subscriptions Subscription[]
  visits       Visit[]
  accessEvents AccessEvent[]
  ruleEvents   AccessRuleEvent[]
  classBookings ClassBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([gymVariantId])
}

model Subscription {
  id String @id @default(cuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  pricePaid Float
  status    SubscriptionStatus

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([memberId])
  @@index([endDate])
  @@index([gymVariantId])
}

model Payment {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  /**
   * Important: Relation fix
   */
  subscriptions Subscription[]

  amount      Float
  currency    String   @default("MAD")
  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([paymentDate])
}

model DemoRequest {
  id             String            @id @default(cuid())
  gymName        String
  gymEmail       String
  adminEmail     String
  adminFirstName String?
  adminLastName  String?
  phone          String?
  address        String?
  city           String?
  country        String?
  plan           GymPlanTier
  message        String?
  status         DemoRequestStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?             @relation("DemoRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdGymId   String?
  createdGym     Gym?              @relation("DemoRequestCreatedGym", fields: [createdGymId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AccessEvent {
  id        String            @id @default(cuid())
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    AccessEventStatus
  source    AccessEventSource @default(SIMULATOR)
  createdAt DateTime          @default(now())

  @@index([memberId])
  @@index([createdAt])
}

model Visit {
  id           String     @id @default(cuid())
  gymId        String
  gym          Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)
  checkIn      DateTime   @default(now())
  checkOut     DateTime?
  overstayMinutes Int?     @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ruleEvents   AccessRuleEvent[]

  @@index([gymId])
  @@index([memberId])
  @@index([gymVariantId])
  @@index([checkIn])
}

model Plan {
  id                 String             @id @default(cuid())
  name               String
  tier               GymPlanTier
  billingInterval    GymBillingInterval
  price              Float              @default(0)
  maxVariants        Int                @default(-1)
  maxMembers         Int                @default(-1)
  capacityPerGym     Int                @default(0)
  capacityPerVariant Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenantPlans        TenantPlan[]

  @@unique([tier, billingInterval])
}

model TenantPlan {
  id               String                @id @default(cuid())
  gymId            String
  gym              Gym                   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  status           GymSubscriptionStatus @default(ACTIVE)
  startsAt         DateTime
  endsAt           DateTime?
  gracePeriodDays  Int                   @default(0)
  freezeStatus     GymFreezeStatus?
  freezeReason     String?
  freezeUntil      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  freezes          TenantPlanFreeze[]

  @@index([gymId, status])
  @@index([planId])
}

model TenantPlanFreeze {
  id           String         @id @default(cuid())
  tenantPlanId String
  tenantPlan   TenantPlan     @relation(fields: [tenantPlanId], references: [id], onDelete: Cascade)
  reason       String
  requestedUntil DateTime?
  liftedAt     DateTime?
  createdById  String?
  createdAt    DateTime       @default(now())
}

model AccessRuleEvent {
  id           String            @id @default(cuid())
  gymId        String
  gym          Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId     String?
  member       Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  visitId      String?
  visit        Visit?            @relation(fields: [visitId], references: [id], onDelete: SetNull)
  gymVariantId String?
  gymVariant   GymVariant?       @relation(fields: [gymVariantId], references: [id], onDelete: SetNull)
  type         AccessRuleType
  severity     AccessRuleSeverity @default(INFO)
  note         String?
  metadata     Json?
  createdAt    DateTime          @default(now())

  @@index([gymId, createdAt])
  @@index([memberId])
  @@index([visitId])
  @@index([gymVariantId])
}

model FeatureOverride {
  id       String          @id @default(cuid())
  gymId    String
  gym      Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  feature  PlanFeatureFlag
  enabled  Boolean         @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([gymId, feature])
  @@index([gymId])
}

model ClassSession {
  id            String     @id @default(cuid())
  gymId         String
  gym           Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymVariantId  String
  gymVariant    GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)
  title         String
  coach         String?
  room          String?
  capacity      Int        @default(0)
  startAt       DateTime
  endAt         DateTime
  waitlist      Boolean    @default(true)
  bookings      ClassBooking[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([gymId])
  @@index([gymVariantId])
  @@index([startAt])
}

model ClassBooking {
  id             String             @id @default(cuid())
  classSessionId String
  classSession   ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status         ClassBookingStatus @default(CONFIRMED)
  position       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([memberId])
  @@index([status])
  @@unique([classSessionId, memberId])
}

model PartnerClub {
  id             String   @id @default(cuid())
  slug           String   @unique
  websiteUrl     String?
  logoUrl        String?
  logoPublicId   String?
  coverUrl       String?
  coverPublicId  String?
  order          Int      @default(0)
  isPublished    Boolean  @default(false)
  translations   PartnerClubTranslation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PartnerClubTranslation {
  id          Int         @id @default(autoincrement())
  partnerId   String
  partner     PartnerClub @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  city        String?
  country     String?
  tagline     String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([partnerId, locale])
  @@index([locale])
}

model MarketingPlan {
  id          String   @id @default(cuid())
  tier        GymPlanTier
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  highlight   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  translations MarketingPlanTranslation[]

  @@unique([tier])
}

model MarketingPlanTranslation {
  id            Int           @id @default(autoincrement())
  planId        String
  plan          MarketingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  description   String?
  highlightLabel String?
  badges        String[]      @default([])
  features      String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([planId, locale])
  @@index([locale])
}
