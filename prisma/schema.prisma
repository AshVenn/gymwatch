generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ============================
 * ENUMS
 * ============================
 */

enum UserRole {
  SUPER_ADMIN
  GYM_OWNER
  GYM_ADMIN
}

enum GymPlanTier {
  BASIC
  PRO
  COMPLEX
}

enum GymBillingInterval {
  MONTHLY
  ANNUAL
}

enum GymSubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRES_TODAY
  EXPIRED
}

enum DemoRequestStatus {
  PENDING
  RESOLVED
  REFUSED
}

enum AccessEventStatus {
  GRANTED
  ALREADY_CHECKED_IN
  DENIED_EXPIRED
  DENIED_INACTIVE
  DENIED_FORBIDDEN
}

enum AccessEventSource {
  QR_SCAN
  SIMULATOR
  MANUAL
}

enum ClassBookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

/**
 * ============================
 * MODELS
 * ============================
 */

model SystemSettings {
  id                    Int      @id @default(1)
  supportEmail          String   @default("support@gymwatch.ma")
  supportPhone          String   @default("+212600000000")
  brandColor            String   @default("#5b4bff")
  expiryReminder        Boolean  @default(true)
  weeklyDigest          Boolean  @default(true)
  incidentAlerts        Boolean  @default(true)
  payoutReport          Boolean  @default(false)
  gymSettingsIntervalMs Int      @default(60000)
  userSettingsIntervalMs Int     @default(30000)
  accessLogRetentionDays Int     @default(90)
  lastPurgeAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  password             String
  role                 UserRole
  firstName            String?
  lastName             String?
  gymId                String?
  gym                  Gym?            @relation(fields: [gymId], references: [id], onDelete: SetNull)
  gymVariantId         String?
  gymVariant           GymVariant?     @relation(fields: [gymVariantId], references: [id], onDelete: SetNull)
  ownedGym             Gym?            @relation("GymOwner")
  resolvedDemoRequests DemoRequest[]   @relation("DemoRequestResolvedBy")
  preferences          UserPreference?
  sessionVersion       Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gym {
  id                          String                @id @default(cuid())
  name                        String
  email                       String                @unique
  phone                       String?
  address                     String?
  city                        String?
  country                     String?
  logoUrl                     String?
  subscriptionPlan            GymPlanTier           @default(BASIC)
  billingInterval             GymBillingInterval    @default(MONTHLY)
  subscriptionPrice           Float                 @default(0)
  subscriptionStatus          GymSubscriptionStatus @default(ACTIVE)
  subscriptionStartedAt       DateTime              @default(now())
  subscriptionExpiresAt       DateTime?
  isDemo                      Boolean               @default(false)
  demoEndsAt                  DateTime?
  subscriptionGracePeriodDays Int                   @default(0)
  maxAdminAccounts            Int                   @default(3)
  lastSettingsUpdateAt        DateTime?
  todayVisitorCount           Int                   @default(0)
  todayVisitorDate            DateTime?             @default(now())
  ownerId                     String?               @unique
  owner                       User?                 @relation("GymOwner", fields: [ownerId], references: [id])
  analyticsSnapshot           Json?
  users                       User[]
  membershipPlans             MembershipPlan[]
  members                     Member[]
  subscriptions               Subscription[]
  payments                    Payment[]
  variants                    GymVariant[]
  visits                      Visit[]
  classSessions               ClassSession[]
  createdDemoRequests         DemoRequest[]         @relation("DemoRequestCreatedGym")
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
}

model GymVariant {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  isDefault   Boolean  @default(false)
  members     Member[]
  subscriptions Subscription[]
  membershipPlans MembershipPlan[]
  admins      User[]
  visits      Visit[]
  classSessions ClassSession[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([gymId, slug])
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         String   @default("system")
  locale        String   @default("fr")
  notifications Boolean  @default(true)
  weeklySummary Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastChangedAt DateTime @default(now())
}

model MembershipPlan {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  name         String
  durationDays Int
  price        Float
  isActive     Boolean @default(true)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymVariantId])
}

model Member {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)

  firstName     String
  lastName      String
  email         String?
  phone         String?
  qrToken       String   @unique @default(dbgenerated("encode(gen_random_bytes(16), 'hex')"))
  qrGeneratedAt DateTime @default(now())
  lastVisitedAt DateTime?

  subscriptions Subscription[]
  visits       Visit[]
  accessEvents AccessEvent[]
  classBookings ClassBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([gymVariantId])
}

model Subscription {
  id String @id @default(cuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  pricePaid Float
  status    SubscriptionStatus

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([memberId])
  @@index([endDate])
  @@index([gymVariantId])
}

model Payment {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  /**
   * Important: Relation fix
   */
  subscriptions Subscription[]

  amount      Float
  currency    String   @default("MAD")
  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId])
  @@index([paymentDate])
}

model DemoRequest {
  id             String            @id @default(cuid())
  gymName        String
  gymEmail       String
  adminEmail     String
  adminFirstName String?
  adminLastName  String?
  phone          String?
  address        String?
  city           String?
  country        String?
  plan           GymPlanTier
  message        String?
  status         DemoRequestStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?             @relation("DemoRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdGymId   String?
  createdGym     Gym?              @relation("DemoRequestCreatedGym", fields: [createdGymId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AccessEvent {
  id        String            @id @default(cuid())
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    AccessEventStatus
  source    AccessEventSource @default(SIMULATOR)
  createdAt DateTime          @default(now())

  @@index([memberId])
  @@index([createdAt])
}

model Visit {
  id           String     @id @default(cuid())
  gymId        String
  gym          Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gymVariantId String
  gymVariant   GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)
  checkIn      DateTime   @default(now())
  checkOut     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([gymId])
  @@index([memberId])
  @@index([gymVariantId])
  @@index([checkIn])
}

model ClassSession {
  id            String     @id @default(cuid())
  gymId         String
  gym           Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymVariantId  String
  gymVariant    GymVariant @relation(fields: [gymVariantId], references: [id], onDelete: Cascade)
  title         String
  coach         String?
  room          String?
  capacity      Int        @default(0)
  startAt       DateTime
  endAt         DateTime
  waitlist      Boolean    @default(true)
  bookings      ClassBooking[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([gymId])
  @@index([gymVariantId])
  @@index([startAt])
}

model ClassBooking {
  id             String             @id @default(cuid())
  classSessionId String
  classSession   ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status         ClassBookingStatus @default(CONFIRMED)
  position       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([memberId])
  @@index([status])
  @@unique([classSessionId, memberId])
}
